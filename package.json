{
  "name": "gas-financial-app",
  "version": "1.0.0",
  "description": "Expense tracker",
  "scripts": {
    "gstart": "clasp push --watch",
    "start": "parcel client/index.html --dist-dir ./dist",
    "build": "parcel build client/index.html --dist-dir build --no-cache && node ./scripts/env_injector.js && vite build && ./scripts/move_artifacts.sh",
    "publish": "npm run build && clasp push -f",
    "test": "jest"
  },
  "keywords": [
    "finance"
  ],
  "author": "Octavian Catlabuga",
  "license": "MIT",
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.5",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.19.0",
    "@google/clasp": "^3.1.3",
    "@types/google-apps-script": "^2.0.8",
    "constants-browserify": "^1.0.0",
    "eslint": "^9.19.0",
    "eslint-plugin-jest": "^29.12.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "parcel": "^2.13.3",
    "process": "^0.11.10",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^7.29.4",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "browserslist": [
    "since 2013",
    "not dead",
    "not ie <= 11"
  ]
}
