{
  "name": "gas-financial-app",
  "version": "1.0.0",
  "description": "Expense tracker",
  "scripts": {
    "gstart": "clasp push --watch",
    "start": "parcel client/index.html --dist-dir ./dist",
    "build": "parcel build client/index.html --no-cache && node ./scripts/env_injector.js && ./scripts/move_artifacts.sh",
  },
  "keywords": [
    "finance"
  ],
  "author": "Octavian Catlabuga",
  "license": "MIT",
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.5",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.19.0",
    "@google/clasp": "^2.5.0",
    "@types/google-apps-script": "^1.0.91",
    "constants-browserify": "^1.0.0",
    "eslint": "^9.19.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "parcel": "^2.13.3",
    "process": "^0.11.10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@mui/x-date-pickers": "^7.24.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "browserslist": [
    "since 2013",
    "not dead",
    "not ie <= 11"
  ],
  "targets": {
    "default": {
      "distDir": "./build",
      "outputFormat": "global",
      "sourceMap": false,
      "optimize": false
    }
  }
}
